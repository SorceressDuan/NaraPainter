<UserControl
    x:Class="NaraDreamPainter.App.Views.PropertiesPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:NaraDreamPainter.App.Controls">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="12" Spacing="12">
            <TextBlock Text="Properties" Style="{StaticResource SubtitleTextBlockStyle}" />

            <ContentControl IsEnabled="{Binding HasSelection}" HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="8">
                    <TextBlock Text="Layer" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBox Header="Name" Text="{Binding SelectedLayer.Name, Mode=TwoWay}" GotFocus="OnNameGotFocus" LostFocus="OnNameLostFocus" />
                    <ComboBox
                        Header="Blend Mode"
                        HorizontalAlignment="Stretch"
                        ItemsSource="{Binding SelectedLayer.BlendModeNames}"
                        SelectedIndex="{Binding SelectedLayer.BlendModeIndex, Mode=TwoWay}" />
                    <controls:AdjustmentSlider
                        Header="Opacity"
                        Minimum="0"
                        Maximum="100"
                        Value="{Binding SelectedLayer.Opacity, Mode=TwoWay}"
                        EditStarted="OnOpacityEditStarted" />
                    <CheckBox Content="Visible" IsChecked="{Binding SelectedLayer.IsVisible, Mode=TwoWay}" />
                    <TextBlock
                        Text="{Binding SelectedLayer.MaskLabel}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </ContentControl>

            <TextBlock Text="Adjustments" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <TextBlock
                Text="{Binding Adjustment.TargetLabel}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <Expander
                Header="Brightness / Contrast"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                IsEnabled="{Binding Adjustment.CanEditBrightnessContrast}">
                <StackPanel Spacing="8">
                    <controls:AdjustmentSlider
                        Header="Brightness"
                        Minimum="-100"
                        Maximum="100"
                        Value="{Binding Adjustment.Brightness, Mode=TwoWay}"
                        EditStarted="OnAdjustmentEditStarted" />
                    <controls:AdjustmentSlider
                        Header="Contrast"
                        Minimum="-100"
                        Maximum="100"
                        Value="{Binding Adjustment.Contrast, Mode=TwoWay}"
                        EditStarted="OnAdjustmentEditStarted" />
                    <Button Content="Reset" HorizontalAlignment="Right" Click="OnResetBrightnessContrast" />
                </StackPanel>
            </Expander>

            <Expander
                Header="Hue / Saturation"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                IsEnabled="{Binding Adjustment.CanEditHueSaturation}">
                <StackPanel Spacing="8">
                    <ComboBox
                        Header="Range"
                        HorizontalAlignment="Stretch"
                        ItemsSource="{Binding Adjustment.RangeNames}"
                        SelectedIndex="{Binding Adjustment.RangeIndex, Mode=TwoWay}" />
                    <controls:AdjustmentSlider
                        Header="Hue"
                        Minimum="-180"
                        Maximum="180"
                        Value="{Binding Adjustment.Hue, Mode=TwoWay}"
                        EditStarted="OnAdjustmentEditStarted" />
                    <controls:AdjustmentSlider
                        Header="Saturation"
                        Minimum="-100"
                        Maximum="100"
                        Value="{Binding Adjustment.Saturation, Mode=TwoWay}"
                        EditStarted="OnAdjustmentEditStarted" />
                    <controls:AdjustmentSlider
                        Header="Lightness"
                        Minimum="-100"
                        Maximum="100"
                        Value="{Binding Adjustment.Lightness, Mode=TwoWay}"
                        EditStarted="OnAdjustmentEditStarted" />
                    <CheckBox Content="Colorize" IsChecked="{Binding Adjustment.Colorize, Mode=TwoWay}" />
                    <Button Content="Reset" HorizontalAlignment="Right" Click="OnResetHueSaturation" />
                </StackPanel>
            </Expander>

            <Expander
                Header="Levels"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                IsEnabled="{Binding Adjustment.CanEditLevels}">
                <StackPanel Spacing="8">
                    <ComboBox
                        Header="Channel"
                        HorizontalAlignment="Stretch"
                        ItemsSource="{Binding Adjustment.ChannelNames}"
                        SelectedIndex="{Binding Adjustment.LevelsChannelIndex, Mode=TwoWay}" />
                    <controls:AdjustmentSlider
                        Header="Black Point"
                        Minimum="0"
                        Maximum="254"
                        Value="{Binding Adjustment.LevelBlack, Mode=TwoWay}"
                        EditStarted="OnAdjustmentEditStarted" />
                    <controls:AdjustmentSlider
                        Header="White Point"
                        Minimum="1"
                        Maximum="255"
                        Value="{Binding Adjustment.LevelWhite, Mode=TwoWay}"
                        EditStarted="OnAdjustmentEditStarted" />
                    <controls:AdjustmentSlider
                        Header="Gamma"
                        Minimum="0.1"
                        Maximum="9.99"
                        Step="0.05"
                        Value="{Binding Adjustment.LevelGamma, Mode=TwoWay}"
                        EditStarted="OnAdjustmentEditStarted" />
                    <controls:AdjustmentSlider
                        Header="Output Black"
                        Minimum="0"
                        Maximum="255"
                        Value="{Binding Adjustment.LevelOutputBlack, Mode=TwoWay}"
                        EditStarted="OnAdjustmentEditStarted" />
                    <controls:AdjustmentSlider
                        Header="Output White"
                        Minimum="0"
                        Maximum="255"
                        Value="{Binding Adjustment.LevelOutputWhite, Mode=TwoWay}"
                        EditStarted="OnAdjustmentEditStarted" />
                    <Button Content="Reset" HorizontalAlignment="Right" Click="OnResetLevels" />
                </StackPanel>
            </Expander>

            <Expander
                Header="Curves"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                IsEnabled="{Binding Adjustment.CanEditCurves}">
                <StackPanel Spacing="8">
                    <ComboBox
                        Header="Channel"
                        HorizontalAlignment="Stretch"
                        ItemsSource="{Binding Adjustment.ChannelNames}"
                        SelectedIndex="{Binding Adjustment.CurveChannelIndex, Mode=TwoWay}" />

                    <ListView
                        ItemsSource="{Binding Adjustment.CurvePoints}"
                        SelectedIndex="{Binding Adjustment.SelectedCurvePointIndex, Mode=TwoWay}"
                        SelectionMode="Single"
                        MaxHeight="180">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="4,2" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        Text="{Binding Label}"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource CaptionTextBlockStyle}" />
                                    <NumberBox
                                        Grid.Column="1"
                                        Width="110"
                                        Minimum="0"
                                        Maximum="255"
                                        SpinButtonPlacementMode="Compact"
                                        IsEnabled="{Binding CanEditX}"
                                        Value="{Binding X, Mode=TwoWay}" />
                                    <NumberBox
                                        Grid.Column="2"
                                        Width="110"
                                        Minimum="0"
                                        Maximum="255"
                                        SpinButtonPlacementMode="Compact"
                                        Value="{Binding Y, Mode=TwoWay}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Button Content="Add Point" Click="OnAddCurvePoint" />
                        <Button Content="Remove" Click="OnRemoveCurvePoint" IsEnabled="{Binding Adjustment.CanRemoveCurvePoint}" />
                        <Button Content="Reset" Click="OnResetCurves" />
                    </StackPanel>
                </StackPanel>
            </Expander>

            <ContentControl IsEnabled="{Binding HasSelection}" HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="8">
                    <TextBlock Text="Selection and Mask" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <ComboBox
                        Header="Shape"
                        HorizontalAlignment="Stretch"
                        ItemsSource="{Binding Selection.ShapeNames}"
                        SelectedIndex="{Binding Selection.ShapeIndex, Mode=TwoWay}" />

                    <Grid ColumnSpacing="8" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <NumberBox Header="X" SpinButtonPlacementMode="Compact" Value="{Binding Selection.X, Mode=TwoWay}" />
                        <NumberBox Grid.Column="1" Header="Y" SpinButtonPlacementMode="Compact" Value="{Binding Selection.Y, Mode=TwoWay}" />
                        <NumberBox Grid.Row="1" Header="Width" SpinButtonPlacementMode="Compact" Value="{Binding Selection.Width, Mode=TwoWay}" />
                        <NumberBox Grid.Row="1" Grid.Column="1" Header="Height" SpinButtonPlacementMode="Compact" Value="{Binding Selection.Height, Mode=TwoWay}" />
                    </Grid>

                    <controls:AdjustmentSlider
                        Header="Feather"
                        Minimum="0"
                        Maximum="200"
                        Value="{Binding Selection.Feather, Mode=TwoWay}" />

                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Button Content="Apply as Mask" Click="OnApplyMask" />
                        <Button Content="Select All" Click="OnSelectAll" />
                        <Button Content="Clear Mask" Click="OnClearMask" IsEnabled="{Binding Selection.HasMask}" />
                    </StackPanel>

                    <TextBlock
                        Text="{Binding Selection.MaskLabel}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </ContentControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
