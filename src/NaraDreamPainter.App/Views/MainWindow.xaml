<Window
    x:Class="NaraDreamPainter.App.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:compositing="using:NaraDreamPainter.Compositing.Controls"
    xmlns:views="using:NaraDreamPainter.App.Views">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <CommandBar Grid.Row="0" DefaultLabelPosition="Right">
            <AppBarButton Icon="OpenFile" Label="{x:Bind Text.ToolbarOpen, Mode=OneWay}" Click="OnOpenClick">
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Modifiers="Control" Key="O" />
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>
            <AppBarButton Icon="Save" Label="{x:Bind Text.ToolbarExport, Mode=OneWay}" Click="OnExportClick">
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Modifiers="Control" Key="E" />
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>
            <AppBarSeparator />
            <AppBarButton
                Icon="Undo"
                Label="{x:Bind Text.ToolbarUndo, Mode=OneWay}"
                Click="OnUndoClick"
                IsEnabled="{x:Bind Document.CanUndo, Mode=OneWay}">
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Modifiers="Control" Key="Z" />
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>
            <AppBarButton
                Icon="Redo"
                Label="{x:Bind Text.ToolbarRedo, Mode=OneWay}"
                Click="OnRedoClick"
                IsEnabled="{x:Bind Document.CanRedo, Mode=OneWay}">
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Modifiers="Control" Key="Y" />
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>
            <AppBarSeparator />
            <AppBarButton Icon="Add" Label="{x:Bind Text.ToolbarNewLayer, Mode=OneWay}" Click="OnNewLayerClick">
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Modifiers="Control,Shift" Key="N" />
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>
            <AppBarButton
                Icon="Copy"
                Label="{x:Bind Text.ToolbarDuplicate, Mode=OneWay}"
                Click="OnDuplicateLayerClick"
                IsEnabled="{x:Bind Document.HasSelection, Mode=OneWay}" />
            <AppBarButton
                Icon="Delete"
                Label="{x:Bind Text.ToolbarDeleteLayer, Mode=OneWay}"
                Click="OnDeleteLayerClick"
                IsEnabled="{x:Bind Document.HasSelection, Mode=OneWay}" />
            <AppBarButton Icon="Edit" Label="{x:Bind Text.ToolbarAdjustmentLayer, Mode=OneWay}">
                <AppBarButton.Flyout>
                    <!-- A flyout is not part of the page's visual tree, so the compiled bindings above
                         do not reach inside it; these are labelled in code-behind instead. -->
                    <MenuFlyout x:Name="AdjustmentFlyout">
                        <MenuFlyoutItem Tag="BrightnessContrast" Click="OnAddAdjustmentLayerClick" />
                        <MenuFlyoutItem Tag="HueSaturation" Click="OnAddAdjustmentLayerClick" />
                        <MenuFlyoutItem Tag="Levels" Click="OnAddAdjustmentLayerClick" />
                        <MenuFlyoutItem Tag="Curves" Click="OnAddAdjustmentLayerClick" />
                    </MenuFlyout>
                </AppBarButton.Flyout>
            </AppBarButton>
            <AppBarSeparator />
            <AppBarToggleButton
                x:Name="MaskBrushButton"
                Icon="Edit"
                Label="{x:Bind Text.ToolbarMaskBrush, Mode=OneWay}"
                Click="OnMaskBrushClick" />
            <AppBarButton Icon="Repair" Label="{x:Bind Text.ToolbarContentAwareFill, Mode=OneWay}" Click="OnContentAwareFillClick">
                <AppBarButton.Flyout>
                    <MenuFlyout x:Name="FillFlyout">
                        <MenuFlyoutItem Click="OnContentAwareFillClick" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Click="OnFeatherMaskClick" />
                        <MenuFlyoutItem Click="OnInvertMaskClick" />
                        <MenuFlyoutItem Click="OnClearMaskClick" />
                    </MenuFlyout>
                </AppBarButton.Flyout>
            </AppBarButton>
            <AppBarSeparator />
            <AppBarButton Icon="ZoomOut" Label="{x:Bind Text.ToolbarZoomOut, Mode=OneWay}" Click="OnZoomOutClick" />
            <AppBarButton Icon="ZoomIn" Label="{x:Bind Text.ToolbarZoomIn, Mode=OneWay}" Click="OnZoomInClick" />
            <AppBarButton Icon="Zoom" Label="{x:Bind Text.ToolbarFit, Mode=OneWay}" Click="OnFitClick" />
            <AppBarButton Label="{x:Bind Text.ToolbarActualSize, Mode=OneWay}" Click="OnActualSizeClick" />
        </CommandBar>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <views:LayersPanel x:Name="Layers" Grid.Column="0" />

            <Border
                Grid.Column="1"
                Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}"
                AllowDrop="True"
                DragOver="OnCanvasDragOver"
                Drop="OnCanvasDrop">
                <compositing:CanvasView x:Name="Canvas" SizeChanged="OnCanvasSizeChanged" />
            </Border>

            <views:PropertiesPanel x:Name="Properties" Grid.Column="2" />
        </Grid>

        <Border
            Grid.Row="2"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}">
            <Grid Padding="12,6" ColumnSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Text="{x:Bind Document.Status, Mode=OneWay}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    VerticalAlignment="Center"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    Grid.Column="1"
                    Text="{x:Bind Document.SizeLabel, Mode=OneWay}"
                    Style="{StaticResource CaptionTextBlockStyle}" />
                <TextBlock
                    Grid.Column="2"
                    Text="{x:Bind Document.LayerCountLabel, Mode=OneWay}"
                    Style="{StaticResource CaptionTextBlockStyle}" />
                <TextBlock
                    Grid.Column="3"
                    MinWidth="56"
                    TextAlignment="Right"
                    Text="{x:Bind Document.ZoomLabel, Mode=OneWay}"
                    Style="{StaticResource CaptionTextBlockStyle}" />
            </Grid>
        </Border>
    </Grid>
</Window>
