<Application
    x:Class="NaraDreamPainter.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:NaraDreamPainter.App.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />

            <!--
                YaHei UI carries the Chinese glyphs and sits on the system either way, so mixed
                Chinese and Latin runs share one family and keep the same baseline. Segoe UI backs it
                up for the Latin-only case where YaHei is absent.
            -->
            <FontFamily x:Key="AppFontFamily">Microsoft YaHei UI, Segoe UI</FontFamily>
        </ResourceDictionary>
    </Application.Resources>
</Application>
