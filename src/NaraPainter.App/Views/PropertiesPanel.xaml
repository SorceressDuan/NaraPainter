<UserControl
    x:Class="NaraPainter.App.Views.PropertiesPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:NaraPainter.App.Controls"
    FontFamily="{StaticResource AppFontFamily}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="12" Spacing="12">
            <TextBlock Text="{x:Bind Text.PropertiesTitle, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" />

            <ContentControl IsEnabled="{Binding HasSelection}" HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="8">
                    <TextBlock Text="{x:Bind Text.PropertiesLayer, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBox Header="{x:Bind Text.PropertiesName, Mode=OneWay}" Text="{Binding SelectedLayer.Name, Mode=TwoWay}" GotFocus="OnNameGotFocus" LostFocus="OnNameLostFocus" />
                    <ComboBox
                        Header="{x:Bind Text.PropertiesBlendMode, Mode=OneWay}"
                        HorizontalAlignment="Stretch"
                        ItemsSource="{Binding SelectedLayer.BlendModeNames}"
                        SelectedIndex="{Binding SelectedLayer.BlendModeIndex, Mode=TwoWay}" />
                    <controls:AdjustmentSlider
                        Header="{x:Bind Text.PropertiesOpacity, Mode=OneWay}"
                        Minimum="0"
                        Maximum="100"
                        Value="{Binding SelectedLayer.Opacity, Mode=TwoWay}"
                        EditStarted="OnOpacityEditStarted" />
                    <CheckBox Content="{x:Bind Text.PropertiesVisible, Mode=OneWay}" IsChecked="{Binding SelectedLayer.IsVisible, Mode=TwoWay}" />
                    <TextBlock
                        Text="{Binding SelectedLayer.MaskLabel}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </ContentControl>

            <TextBlock Text="{x:Bind Text.PropertiesAdjustments, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <TextBlock
                Text="{Binding Adjustment.TargetLabel}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <Expander
                Header="{x:Bind Text.AdjustBrightnessContrast, Mode=OneWay}"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                IsEnabled="{Binding Adjustment.CanEditBrightnessContrast}">
                <StackPanel Spacing="8">
                    <controls:AdjustmentSlider
                        Header="{x:Bind Text.PropertiesBrightness, Mode=OneWay}"
                        Minimum="-100"
                        Maximum="100"
                        Value="{Binding Adjustment.Brightness, Mode=TwoWay}"
                        EditStarted="OnAdjustmentEditStarted" />
                    <controls:AdjustmentSlider
                        Header="{x:Bind Text.PropertiesContrast, Mode=OneWay}"
                        Minimum="-100"
                        Maximum="100"
                        Value="{Binding Adjustment.Contrast, Mode=TwoWay}"
                        EditStarted="OnAdjustmentEditStarted" />
                    <Button Content="{x:Bind Text.PropertiesReset, Mode=OneWay}" HorizontalAlignment="Right" Click="OnResetBrightnessContrast" />
                </StackPanel>
            </Expander>

            <Expander
                Header="{x:Bind Text.AdjustHueSaturation, Mode=OneWay}"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                IsEnabled="{Binding Adjustment.CanEditHueSaturation}">
                <StackPanel Spacing="8">
                    <ComboBox
                        Header="{x:Bind Text.PropertiesRange, Mode=OneWay}"
                        HorizontalAlignment="Stretch"
                        ItemsSource="{Binding Adjustment.RangeNames}"
                        SelectedIndex="{Binding Adjustment.RangeIndex, Mode=TwoWay}" />
                    <controls:AdjustmentSlider
                        Header="{x:Bind Text.PropertiesHue, Mode=OneWay}"
                        Minimum="-180"
                        Maximum="180"
                        Value="{Binding Adjustment.Hue, Mode=TwoWay}"
                        EditStarted="OnAdjustmentEditStarted" />
                    <controls:AdjustmentSlider
                        Header="{x:Bind Text.PropertiesSaturation, Mode=OneWay}"
                        Minimum="-100"
                        Maximum="100"
                        Value="{Binding Adjustment.Saturation, Mode=TwoWay}"
                        EditStarted="OnAdjustmentEditStarted" />
                    <controls:AdjustmentSlider
                        Header="{x:Bind Text.PropertiesLightness, Mode=OneWay}"
                        Minimum="-100"
                        Maximum="100"
                        Value="{Binding Adjustment.Lightness, Mode=TwoWay}"
                        EditStarted="OnAdjustmentEditStarted" />
                    <CheckBox Content="{x:Bind Text.PropertiesColorize, Mode=OneWay}" IsChecked="{Binding Adjustment.Colorize, Mode=TwoWay}" />
                    <Button Content="{x:Bind Text.PropertiesReset, Mode=OneWay}" HorizontalAlignment="Right" Click="OnResetHueSaturation" />
                </StackPanel>
            </Expander>

            <Expander
                Header="{x:Bind Text.AdjustLevels, Mode=OneWay}"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                IsEnabled="{Binding Adjustment.CanEditLevels}">
                <StackPanel Spacing="8">
                    <ComboBox
                        Header="{x:Bind Text.PropertiesChannel, Mode=OneWay}"
                        HorizontalAlignment="Stretch"
                        ItemsSource="{Binding Adjustment.ChannelNames}"
                        SelectedIndex="{Binding Adjustment.LevelsChannelIndex, Mode=TwoWay}" />
                    <controls:AdjustmentSlider
                        Header="{x:Bind Text.PropertiesBlackPoint, Mode=OneWay}"
                        Minimum="0"
                        Maximum="254"
                        Value="{Binding Adjustment.LevelBlack, Mode=TwoWay}"
                        EditStarted="OnAdjustmentEditStarted" />
                    <controls:AdjustmentSlider
                        Header="{x:Bind Text.PropertiesWhitePoint, Mode=OneWay}"
                        Minimum="1"
                        Maximum="255"
                        Value="{Binding Adjustment.LevelWhite, Mode=TwoWay}"
                        EditStarted="OnAdjustmentEditStarted" />
                    <controls:AdjustmentSlider
                        Header="{x:Bind Text.PropertiesGamma, Mode=OneWay}"
                        Minimum="0.1"
                        Maximum="9.99"
                        Step="0.05"
                        Value="{Binding Adjustment.LevelGamma, Mode=TwoWay}"
                        EditStarted="OnAdjustmentEditStarted" />
                    <controls:AdjustmentSlider
                        Header="{x:Bind Text.PropertiesOutputBlack, Mode=OneWay}"
                        Minimum="0"
                        Maximum="255"
                        Value="{Binding Adjustment.LevelOutputBlack, Mode=TwoWay}"
                        EditStarted="OnAdjustmentEditStarted" />
                    <controls:AdjustmentSlider
                        Header="{x:Bind Text.PropertiesOutputWhite, Mode=OneWay}"
                        Minimum="0"
                        Maximum="255"
                        Value="{Binding Adjustment.LevelOutputWhite, Mode=TwoWay}"
                        EditStarted="OnAdjustmentEditStarted" />
                    <Button Content="{x:Bind Text.PropertiesReset, Mode=OneWay}" HorizontalAlignment="Right" Click="OnResetLevels" />
                </StackPanel>
            </Expander>

            <Expander
                Header="{x:Bind Text.AdjustCurves, Mode=OneWay}"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                IsEnabled="{Binding Adjustment.CanEditCurves}">
                <StackPanel Spacing="8">
                    <ComboBox
                        Header="{x:Bind Text.PropertiesChannel, Mode=OneWay}"
                        HorizontalAlignment="Stretch"
                        ItemsSource="{Binding Adjustment.ChannelNames}"
                        SelectedIndex="{Binding Adjustment.CurveChannelIndex, Mode=TwoWay}" />

                    <ListView
                        ItemsSource="{Binding Adjustment.CurvePoints}"
                        SelectedIndex="{Binding Adjustment.SelectedCurvePointIndex, Mode=TwoWay}"
                        SelectionMode="Single"
                        MaxHeight="180">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="4,2" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        Text="{Binding Label}"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource CaptionTextBlockStyle}" />
                                    <NumberBox
                                        Grid.Column="1"
                                        Width="110"
                                        Minimum="0"
                                        Maximum="255"
                                        SpinButtonPlacementMode="Compact"
                                        IsEnabled="{Binding CanEditX}"
                                        Value="{Binding X, Mode=TwoWay}" />
                                    <NumberBox
                                        Grid.Column="2"
                                        Width="110"
                                        Minimum="0"
                                        Maximum="255"
                                        SpinButtonPlacementMode="Compact"
                                        Value="{Binding Y, Mode=TwoWay}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Button Content="{x:Bind Text.PropertiesAddPoint, Mode=OneWay}" Click="OnAddCurvePoint" />
                        <Button Content="{x:Bind Text.PropertiesRemovePoint, Mode=OneWay}" Click="OnRemoveCurvePoint" IsEnabled="{Binding Adjustment.CanRemoveCurvePoint}" />
                        <Button Content="{x:Bind Text.PropertiesReset, Mode=OneWay}" Click="OnResetCurves" />
                    </StackPanel>
                </StackPanel>
            </Expander>

            <ContentControl IsEnabled="{Binding HasSelection}" HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="8">
                    <TextBlock Text="{x:Bind Text.PropertiesSelectionAndMask, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <ComboBox
                        Header="{x:Bind Text.PropertiesShape, Mode=OneWay}"
                        HorizontalAlignment="Stretch"
                        ItemsSource="{Binding Selection.ShapeNames}"
                        SelectedIndex="{Binding Selection.ShapeIndex, Mode=TwoWay}" />

                    <Grid ColumnSpacing="8" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <NumberBox Header="{x:Bind Text.PropertiesX, Mode=OneWay}" SpinButtonPlacementMode="Compact" Value="{Binding Selection.X, Mode=TwoWay}" />
                        <NumberBox Grid.Column="1" Header="{x:Bind Text.PropertiesY, Mode=OneWay}" SpinButtonPlacementMode="Compact" Value="{Binding Selection.Y, Mode=TwoWay}" />
                        <NumberBox Grid.Row="1" Header="{x:Bind Text.PropertiesWidth, Mode=OneWay}" SpinButtonPlacementMode="Compact" Value="{Binding Selection.Width, Mode=TwoWay}" />
                        <NumberBox Grid.Row="1" Grid.Column="1" Header="{x:Bind Text.PropertiesHeight, Mode=OneWay}" SpinButtonPlacementMode="Compact" Value="{Binding Selection.Height, Mode=TwoWay}" />
                    </Grid>

                    <controls:AdjustmentSlider
                        Header="{x:Bind Text.PropertiesFeather, Mode=OneWay}"
                        Minimum="0"
                        Maximum="200"
                        Value="{Binding Selection.Feather, Mode=TwoWay}" />

                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Button Content="{x:Bind Text.PropertiesApplyAsMask, Mode=OneWay}" Click="OnApplyMask" />
                        <Button Content="{x:Bind Text.PropertiesSelectAll, Mode=OneWay}" Click="OnSelectAll" />
                        <Button Content="{x:Bind Text.PropertiesClearMask, Mode=OneWay}" Click="OnClearMask" IsEnabled="{Binding Selection.HasMask}" />
                    </StackPanel>

                    <TextBlock
                        Text="{Binding Selection.MaskLabel}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />

                    <TextBlock
                        Text="{Binding Selection.SelectionLabel}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </ContentControl>

            <ContentControl IsEnabled="{Binding HasSelection}" HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="8">
                    <TextBlock Text="{x:Bind Text.MaskBrush, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />

                    <ToggleSwitch
                        IsOn="{Binding MaskBrush.IsActive, Mode=TwoWay}"
                        OnContent="{x:Bind Text.CommonOn, Mode=OneWay}"
                        OffContent="{x:Bind Text.CommonOff, Mode=OneWay}" />

                    <controls:AdjustmentSlider
                        Header="{x:Bind Text.MaskSize, Mode=OneWay}"
                        Minimum="1"
                        Maximum="400"
                        Value="{Binding MaskBrush.Size, Mode=TwoWay}" />

                    <controls:AdjustmentSlider
                        Header="{x:Bind Text.MaskHardness, Mode=OneWay}"
                        Minimum="0"
                        Maximum="1"
                        Value="{Binding MaskBrush.Hardness, Mode=TwoWay}" />

                    <controls:AdjustmentSlider
                        Header="{x:Bind Text.MaskOpacity, Mode=OneWay}"
                        Minimum="0"
                        Maximum="1"
                        Value="{Binding MaskBrush.Opacity, Mode=TwoWay}" />

                    <ToggleSwitch
                        IsOn="{Binding MaskBrush.Erase, Mode=TwoWay}"
                        OnContent="{x:Bind Text.MaskErase, Mode=OneWay}"
                        OffContent="{x:Bind Text.MaskPaint, Mode=OneWay}" />

                    <controls:AdjustmentSlider
                        Header="{x:Bind Text.MaskFeatherRadius, Mode=OneWay}"
                        Minimum="0.5"
                        Maximum="100"
                        Value="{Binding MaskBrush.FeatherRadius, Mode=TwoWay}" />

                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Button Content="{x:Bind Text.MaskFeather, Mode=OneWay}" Click="OnFeatherMask" />
                        <Button Content="{x:Bind Text.MaskInvert, Mode=OneWay}" Click="OnInvertMask" />
                        <Button Content="{x:Bind Text.SelectionClear, Mode=OneWay}" Click="OnClearSelection" />
                    </StackPanel>
                </StackPanel>
            </ContentControl>

            <ContentControl IsEnabled="{Binding HasSelection}" HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="8">
                    <TextBlock Text="{x:Bind Text.SpotHealTitle, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />

                    <ToggleSwitch
                        IsOn="{Binding SpotHeal.IsActive, Mode=TwoWay}"
                        OnContent="{x:Bind Text.CommonOn, Mode=OneWay}"
                        OffContent="{x:Bind Text.CommonOff, Mode=OneWay}" />

                    <ComboBox
                        Header="{x:Bind Text.SpotHealMode, Mode=OneWay}"
                        ItemsSource="{Binding SpotHeal.ModeNames}"
                        SelectedIndex="{Binding SpotHeal.ModeIndex, Mode=TwoWay}"
                        HorizontalAlignment="Stretch" />

                    <controls:AdjustmentSlider
                        Header="{x:Bind Text.MaskSize, Mode=OneWay}"
                        Minimum="1"
                        Maximum="400"
                        Value="{Binding SpotHeal.Size, Mode=TwoWay}" />

                    <controls:AdjustmentSlider
                        Header="{x:Bind Text.MaskHardness, Mode=OneWay}"
                        Minimum="0"
                        Maximum="1"
                        Value="{Binding SpotHeal.Hardness, Mode=TwoWay}" />

                    <controls:AdjustmentSlider
                        Header="{x:Bind Text.MaskOpacity, Mode=OneWay}"
                        Minimum="0"
                        Maximum="1"
                        Value="{Binding SpotHeal.Opacity, Mode=TwoWay}" />
                </StackPanel>
            </ContentControl>

            <ContentControl IsEnabled="{Binding HasSelection}" HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="8">
                    <TextBlock Text="{x:Bind Text.FillContentAware, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />

                    <controls:AdjustmentSlider
                        Header="{x:Bind Text.FillRadius, Mode=OneWay}"
                        Minimum="1"
                        Maximum="50"
                        Value="{Binding ContentFill.Radius, Mode=TwoWay}" />

                    <ToggleSwitch
                        Header="{x:Bind Text.FillUseNikolai, Mode=OneWay}"
                        IsOn="{Binding ContentFill.UseNikolai, Mode=TwoWay}"
                        OnContent="{x:Bind Text.CommonOn, Mode=OneWay}"
                        OffContent="{x:Bind Text.CommonOff, Mode=OneWay}" />

                    <Button
                        Content="{x:Bind Text.FillRun, Mode=OneWay}"
                        Click="OnContentAwareFill"
                        IsEnabled="{Binding ContentFill.CanFill}" />
                </StackPanel>
            </ContentControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
