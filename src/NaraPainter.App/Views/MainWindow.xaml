<Window
    x:Class="NaraPainter.App.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:compositing="using:NaraPainter.Compositing.Controls"
    xmlns:app="using:NaraPainter.App"
    xmlns:views="using:NaraPainter.App.Views">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Icon-only, because the labels are what pushed the brush tools off the right edge on a
             window narrow enough to be common: at the 48px an icon-only AppBarButton needs, the whole
             bar fits inside 1080px, and the labels still read in the tooltips and to a screen reader.
             IsDynamicOverflowEnabled is the fallback for anything narrower: commands trade places with
             the overflow menu by DynamicOverflowOrder, so the four low ones go first and the pixel
             tools last. -->
        <CommandBar
            Grid.Row="0"
            DefaultLabelPosition="Collapsed"
            IsDynamicOverflowEnabled="True"
            OverflowButtonVisibility="Auto"
            FontFamily="{StaticResource AppFontFamily}">
            <AppBarButton
                Icon="OpenFile"
                Label="{x:Bind Text.ToolbarOpen, Mode=OneWay}"
                ToolTipService.ToolTip="{x:Bind Text.ToolbarOpenHint, Mode=OneWay}"
                Click="OnOpenClick">

            </AppBarButton>
            <AppBarButton
                Icon="Save"
                Label="{x:Bind Text.ToolbarExport, Mode=OneWay}"
                ToolTipService.ToolTip="{x:Bind Text.ToolbarExportHint, Mode=OneWay}"
                Click="OnExportClick">

            </AppBarButton>
            <AppBarSeparator />
            <AppBarButton
                Icon="Undo"
                Label="{x:Bind Text.ToolbarUndo, Mode=OneWay}"
                ToolTipService.ToolTip="{x:Bind Text.ToolbarUndoHint, Mode=OneWay}"
                Click="OnUndoClick"
                IsEnabled="{x:Bind Document.CanUndo, Mode=OneWay}">

            </AppBarButton>
            <AppBarButton
                Icon="Redo"
                Label="{x:Bind Text.ToolbarRedo, Mode=OneWay}"
                ToolTipService.ToolTip="{x:Bind Text.ToolbarRedoHint, Mode=OneWay}"
                Click="OnRedoClick"
                IsEnabled="{x:Bind Document.CanRedo, Mode=OneWay}">

            </AppBarButton>
            <AppBarSeparator />
            <AppBarButton
                Icon="Add"
                Label="{x:Bind Text.ToolbarNewLayer, Mode=OneWay}"
                ToolTipService.ToolTip="{x:Bind Text.ToolbarNewLayerHint, Mode=OneWay}"
                Click="OnNewLayerClick">

            </AppBarButton>
            <AppBarButton
                Icon="Copy"
                Label="{x:Bind Text.ToolbarDuplicate, Mode=OneWay}"
                ToolTipService.ToolTip="{x:Bind Text.ToolbarDuplicateHint, Mode=OneWay}"
                Click="OnDuplicateLayerClick"
                IsEnabled="{x:Bind Document.HasSelection, Mode=OneWay}" />
            <AppBarButton
                Icon="Delete"
                Label="{x:Bind Text.ToolbarDeleteLayer, Mode=OneWay}"
                ToolTipService.ToolTip="{x:Bind Text.ToolbarDeleteHint, Mode=OneWay}"
                Click="OnDeleteLayerClick"
                IsEnabled="{x:Bind Document.HasSelection, Mode=OneWay}" />
            <AppBarButton
                Icon="Edit"
                Label="{x:Bind Text.ToolbarAdjustmentLayer, Mode=OneWay}"
                ToolTipService.ToolTip="{x:Bind Text.ToolbarAdjustmentLayerHint, Mode=OneWay}"
                DynamicOverflowOrder="3">
                <AppBarButton.Flyout>
                    <!-- A flyout is not part of the page's visual tree, so the compiled bindings above
                         do not reach inside it; these are labelled in code-behind instead. -->
                    <MenuFlyout x:Name="AdjustmentFlyout">
                        <MenuFlyoutItem Tag="BrightnessContrast" Click="OnAddAdjustmentLayerClick" />
                        <MenuFlyoutItem Tag="HueSaturation" Click="OnAddAdjustmentLayerClick" />
                        <MenuFlyoutItem Tag="Levels" Click="OnAddAdjustmentLayerClick" />
                        <MenuFlyoutItem Tag="Curves" Click="OnAddAdjustmentLayerClick" />
                    </MenuFlyout>
                </AppBarButton.Flyout>
            </AppBarButton>
            <AppBarSeparator />
            <AppBarToggleButton
                x:Name="MaskBrushButton"
                Icon="Edit"
                Label="{x:Bind Text.ToolbarMaskBrush, Mode=OneWay}"
                ToolTipService.ToolTip="{x:Bind Text.ToolbarMaskBrushHint, Mode=OneWay}"
                DynamicOverflowOrder="2"
                Click="OnMaskBrushClick" />
            <AppBarToggleButton
                x:Name="SpotHealButton"
                Icon="Repair"
                Label="{x:Bind Text.ToolbarSpotHeal, Mode=OneWay}"
                ToolTipService.ToolTip="{x:Bind Text.ToolbarSpotHealHint, Mode=OneWay}"
                DynamicOverflowOrder="1"
                Click="OnSpotHealClick" />
            <AppBarButton
                Icon="Repair"
                Label="{x:Bind Text.ToolbarContentAwareFill, Mode=OneWay}"
                ToolTipService.ToolTip="{x:Bind Text.ToolbarContentAwareFillHint, Mode=OneWay}"
                DynamicOverflowOrder="4"
                Click="OnContentAwareFillClick">
                <AppBarButton.Flyout>
                    <MenuFlyout x:Name="FillFlyout">
                        <MenuFlyoutItem Click="OnContentAwareFillClick" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Click="OnFeatherMaskClick" />
                        <MenuFlyoutItem Click="OnInvertMaskClick" />
                        <MenuFlyoutItem Click="OnClearMaskClick" />
                    </MenuFlyout>
                </AppBarButton.Flyout>
            </AppBarButton>
            <AppBarSeparator />
            <AppBarButton
                Icon="Rotate"
                Label="{x:Bind Text.ToolbarTransform, Mode=OneWay}"
                ToolTipService.ToolTip="{x:Bind app:Strings.ToolbarTransformHint}"
                DynamicOverflowOrder="5">
                <AppBarButton.Flyout>
                    <!-- Flyouts are outside the page's visual tree, so these are labelled in
                         code-behind; see LabelFlyouts. -->
                    <MenuFlyout x:Name="TransformFlyout">
                        <MenuFlyoutItem Click="OnRotateRightClick" />
                        <MenuFlyoutItem Click="OnRotateLeftClick" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Click="OnFlipHorizontalClick" />
                        <MenuFlyoutItem Click="OnFlipVerticalClick" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Click="OnCropToSelectionClick" />
                        <MenuFlyoutItem Click="OnResizeCanvasClick" />
                    </MenuFlyout>
                </AppBarButton.Flyout>
            </AppBarButton>
            <AppBarToggleButton
                x:Name="ColorPickerButton"
                Icon="Highlight"
                Label="{x:Bind Text.ToolbarColorPicker, Mode=OneWay}"
                ToolTipService.ToolTip="{x:Bind app:Strings.ToolbarColorPickerHint}"
                Click="OnColorPickerClick" />
            <AppBarToggleButton
                x:Name="TextButton"
                Icon="Font"
                Label="{x:Bind Text.ToolbarText, Mode=OneWay}"
                ToolTipService.ToolTip="{x:Bind Text.ToolbarTextHint, Mode=OneWay}"
                DynamicOverflowOrder="3"
                Click="OnTextClick" />
            <AppBarButton
                Icon="Filter"
                Label="{x:Bind Text.ToolbarFilters, Mode=OneWay}"
                ToolTipService.ToolTip="{x:Bind app:Strings.ToolbarFiltersHint}"
                DynamicOverflowOrder="6">
                <AppBarButton.Flyout>
                    <MenuFlyout x:Name="FilterFlyout">
                        <MenuFlyoutItem Click="OnGaussianBlurClick" />
                        <MenuFlyoutItem Click="OnSharpenClick" />
                    </MenuFlyout>
                </AppBarButton.Flyout>
            </AppBarButton>
            <AppBarSeparator />
            <AppBarButton
                Icon="ZoomOut"
                Label="{x:Bind Text.ToolbarZoomOut, Mode=OneWay}"
                ToolTipService.ToolTip="{x:Bind Text.ToolbarZoomOutHint, Mode=OneWay}"
                Click="OnZoomOutClick" />
            <AppBarButton
                Icon="ZoomIn"
                Label="{x:Bind Text.ToolbarZoomIn, Mode=OneWay}"
                ToolTipService.ToolTip="{x:Bind Text.ToolbarZoomInHint, Mode=OneWay}"
                Click="OnZoomInClick" />
            <AppBarButton
                Icon="Zoom"
                Label="{x:Bind Text.ToolbarFit, Mode=OneWay}"
                ToolTipService.ToolTip="{x:Bind Text.ToolbarFitHint, Mode=OneWay}"
                Click="OnFitClick" />
            <AppBarButton
                Label="{x:Bind Text.ToolbarActualSize, Mode=OneWay}"
                ToolTipService.ToolTip="{x:Bind Text.ToolbarActualSizeHint, Mode=OneWay}"
                Click="OnActualSizeClick" />
        </CommandBar>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <views:LayersPanel x:Name="Layers" Grid.Column="0" />

            <Border
                Grid.Column="1"
                Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}"
                AllowDrop="True"
                DragOver="OnCanvasDragOver"
                Drop="OnCanvasDrop">
                <compositing:CanvasView x:Name="Canvas" SizeChanged="OnCanvasSizeChanged" />
            </Border>

            <views:PropertiesPanel x:Name="Properties" Grid.Column="2" />
        </Grid>

        <Border
            Grid.Row="2"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}">
            <Grid Padding="12,6" ColumnSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock
                    Text="{x:Bind Document.Status, Mode=OneWay}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    FontFamily="{StaticResource AppFontFamily}"
                    VerticalAlignment="Center"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    Grid.Column="1"
                    Text="{x:Bind Document.SizeLabel, Mode=OneWay}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    FontFamily="{StaticResource AppFontFamily}"
                    VerticalAlignment="Center" />
                <TextBlock
                    Grid.Column="2"
                    Text="{x:Bind Document.LayerCountLabel, Mode=OneWay}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    FontFamily="{StaticResource AppFontFamily}"
                    VerticalAlignment="Center" />
                <TextBlock
                    Grid.Column="3"
                    MinWidth="56"
                    TextAlignment="Right"
                    Text="{x:Bind Document.ZoomLabel, Mode=OneWay}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    FontFamily="{StaticResource AppFontFamily}"
                    VerticalAlignment="Center" />

                <!-- The language picker lives here rather than in a settings page: it takes one
                     selection, and the status bar is always on screen. -->
                <StackPanel
                    Grid.Column="4"
                    Orientation="Horizontal"
                    Spacing="6"
                    VerticalAlignment="Center">
                    <Button
                        Content="{x:Bind Text.AboutTitle, Mode=OneWay}"
                        Padding="8,2"
                        FontFamily="{StaticResource AppFontFamily}"
                        Click="OnAboutClick" />
                    <TextBlock
                        Text="{x:Bind Text.LanguageLabel, Mode=OneWay}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        FontFamily="{StaticResource AppFontFamily}"
                        VerticalAlignment="Center" />
                    <ComboBox
                        x:Name="LanguagePicker"
                        MinWidth="132"
                        FontFamily="{StaticResource AppFontFamily}"
                        SelectionChanged="OnLanguageChanged" />
                </StackPanel>

                <!-- Filter settings and the eyedropper's reading. Both are things a user reaches for
                     while working on the canvas, so they sit in the strip that is always visible. -->
                <StackPanel
                    Grid.Row="1"
                    Grid.Column="0"
                    Orientation="Horizontal"
                    Spacing="12"
                    Margin="0,4,0,0"
                    VerticalAlignment="Center">
                    <TextBlock
                        Text="{x:Bind Text.FilterRadius, Mode=OneWay}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        FontFamily="{StaticResource AppFontFamily}"
                        VerticalAlignment="Center" />
                    <Slider
                        x:Name="BlurRadiusSlider"
                        Width="120"
                        Minimum="1"
                        Maximum="40"
                        StepFrequency="1"
                        Value="6"
                        VerticalAlignment="Center" />
                    <TextBlock
                        Text="{x:Bind Text.FilterAmount, Mode=OneWay}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        FontFamily="{StaticResource AppFontFamily}"
                        VerticalAlignment="Center" />
                    <Slider
                        x:Name="SharpenAmountSlider"
                        Width="120"
                        Minimum="0.1"
                        Maximum="3"
                        StepFrequency="0.1"
                        Value="1"
                        VerticalAlignment="Center" />
                    <Border
                        x:Name="SampleSwatch"
                        Width="18"
                        Height="18"
                        CornerRadius="3"
                        BorderThickness="1"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        VerticalAlignment="Center" />
                    <TextBlock
                        Text="{x:Bind Document.ColorPicker.Hex, Mode=OneWay}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        FontFamily="{StaticResource AppFontFamily}"
                        VerticalAlignment="Center" />
                    <TextBlock
                        Text="{x:Bind Document.ColorPicker.Channels, Mode=OneWay}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        FontFamily="{StaticResource AppFontFamily}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        VerticalAlignment="Center" />
                    <Button
                        Content="{x:Bind Text.ColorPickerCopy, Mode=OneWay}"
                        Padding="8,2"
                        FontFamily="{StaticResource AppFontFamily}"
                        Click="OnCopyColorClick" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
