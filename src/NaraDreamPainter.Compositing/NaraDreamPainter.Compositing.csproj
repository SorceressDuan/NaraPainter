<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>NaraDreamPainter.Compositing</RootNamespace>
    <Platforms>x64;ARM64</Platforms>
    <!-- Win2D only ships native binaries, so the default build cannot be AnyCPU. -->
    <Platform Condition="'$(Platform)' == '' or '$(Platform)' == 'AnyCPU'">x64</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <!-- The Windows App SDK single-file targets embed resources.pri and demand this. -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <!--
      Only the app that ships produces the self-contained Windows App SDK payload. Leaving this on in a
      library makes both projects stage the same MsixContent, and publishing them together fails with
      NETSDK1152 (duplicate CoreMessagingXP.dll, DirectML.dll and friends).
    -->
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NaraDreamPainter.Models\NaraDreamPainter.Models.csproj" />
  </ItemGroup>

</Project>
